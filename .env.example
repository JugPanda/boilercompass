# Public issue/form URL used by “Report a correction” links.
NEXT_PUBLIC_CORRECTIONS_URL=https://github.com/JugPanda/boilercompass/issues/new

# Public analytics launch date (YYYY-MM-DD). Leave blank until tracking starts.
NEXT_PUBLIC_ANALYTICS_TRACKING_START_DATE=

# Server-only Vercel Web Analytics aggregate API access.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
# Optional for personally owned projects.
VERCEL_ANALYTICS_TEAM_ID=

# Server-only Upstash Redis presence storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random server-only HMAC secret; required whenever Redis presence is configured.
BOILERCOMPASS_PRESENCE_SECRET=
# Optional base; VERCEL_ENV and preview git ref isolation are automatic.
PUBLIC_STATS_NAMESPACE=boilercompass
